# ──────────────────────────────────────────────
#  Lotto Journal — API Environment Variables
#  Copy this file to .env and fill in the values
#  $ cp .env.example .env
# ──────────────────────────────────────────────

# ── Database ───────────────────────────────────
# PostgreSQL connection string (DSN).
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=<mode>
DB_DSN="postgresql://lotto:password@localhost:5432/lotto_db?sslmode=disable"
# DB_MAX_IDLE_CONNS=0       # Maximum number of idle connections (default: 0)
# DB_MAX_OPEN_CONNS=5       # Maximum number of open connections (default: 5)
# DB_CONN_MAX_LIFETIME=3m   # Maximum lifetime of a connection (default: 3m)
# DB_CONN_MAX_IDLE_TIME=1m  # Maximum idle time of a connection before being closed (default: 1m)

# ── Server ─────────────────────────────────────
# TCP port the Fiber HTTP server listens on.
PORT=":3000"

# ── Environment ────────────────────────────────
# App environment: "development", "staging", "production".
# Swagger documentation is disabled in "production".
APP_ENV="development"

# ── LINE Messaging API ─────────────────────────
# Used to verify that incoming webhook requests genuinely originate from LINE.
LINE_CHANNEL_SECRET="your_line_channel_secret_here"
# Long-lived token used to call LINE's reply / push message APIs.
LINE_CHANNEL_ACCESS_TOKEN="your_line_channel_access_token_here"

# ── Job Trigger / Cron Secret ──────────────────
# Secret token used to authenticate POST requests from GitHub Actions workflows.
CRON_SECRET="local-cron-secret-change-me"
